#!/bin/sh
# Build-time-only hook for the isolated SP11 CPS feedback boot.

PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs) prereqs; exit 0 ;;
esac

. /usr/share/initramfs-tools/hook-functions

[ "${version:-}" = "7.1.5-sp11-audio-clean+" ] || exit 0
[ "${SP11_AUDIO_CPS_LAB_INITRAMFS:-}" = "1" ] || exit 0

artifact_dir=/home/geoca/Documents/SP11-PROJECT/05-audio-integration/artifacts/audio-cps-lab-candidate-20260810
observe_dir=/home/geoca/Documents/SP11-PROJECT/05-audio-integration/artifacts/audio-observe-candidate-20260810

install_replacement()
{
	module=$1
	candidate=$2
	expected=$3

	[ -f "$candidate" ] || {
		echo "SP11 CPS-Lab module is missing: $candidate" >&2
		exit 1
	}
	[ "$(sha256sum "$candidate" | awk '{print $1}')" = "$expected" ] || {
		echo "SP11 CPS-Lab hash mismatch: $candidate" >&2
		exit 1
	}

	source_path=$(modinfo -k "$version" -n "$module")
	case "$source_path" in
	/lib/*) archive_path=/usr$source_path ;;
	/*) archive_path=$source_path ;;
	*)
		echo "unexpected $module path: $source_path" >&2
		exit 1
	;;
	esac

	destination=$DESTDIR$archive_path
	install -d "$(dirname "$destination")"
	install -m 0644 "$candidate" "$destination"
	force_load "$module"

	[ "$(sha256sum "$destination" | awk '{print $1}')" = "$expected" ] || {
		echo "embedded SP11 CPS-Lab hash mismatch: $module" >&2
		exit 1
	}
}

install_replacement soundwire-qcom \
