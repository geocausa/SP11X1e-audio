#!/bin/sh
set -eu
PROFILE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sp11-dolby"
PROFILE_FILE="$PROFILE_DIR/profile"
GEQ_FILE="$PROFILE_DIR/geq"
DROPIN_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/filter-chain.service.d"
PROFILE_DROPIN="$DROPIN_DIR/sp11-dolby-profile.conf"
CONTROL_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sp11-dolby-profile.control"

node_id() {
  wpctl status -n | grep "$1" | grep -vE '^[[:space:]]*0\. Audio/Sink' \
    | head -1 | grep -oE '[0-9]+\.' | head -1 | tr -d '.'
}
normalize_profile() {
  case "${1:-}" in
    dynamic) echo dynamic ;;
    movie) echo movie ;;
    music) echo music ;;
    game|gaming) echo game ;;
    voice) echo voice ;;
    onlinecourse|online-course|course) echo onlinecourse ;;
    personalize|personalized|custom|custom1|custom2|custom3) echo personalize ;;
    *) return 1 ;;
  esac
}
profile_index() {
  case "$1" in
    dynamic) echo 0 ;; movie) echo 1 ;; music) echo 2 ;; game) echo 3 ;;
    voice) echo 4 ;; onlinecourse) echo 5 ;; personalize) echo 6 ;;
    *) return 1 ;;
  esac
}
profile_name_from_index() {
  case "$1" in
    0) echo dynamic ;; 1) echo movie ;; 2) echo music ;; 3) echo game ;;
    4) echo voice ;; 5) echo onlinecourse ;; 6) echo personalize ;;
    *) return 1 ;;
  esac
}
profile_code() {
  I=$(profile_index "$1") || return 1
  echo $((I + 1))
}
profile_name_from_code() {
  C=$1
  [ "$C" -ge 1 ] 2>/dev/null && [ "$C" -le 7 ] 2>/dev/null || return 1
  profile_name_from_index $((C - 1))
}
current_profile() {
  if [ -s "$PROFILE_FILE" ]; then cat "$PROFILE_FILE"; else echo dynamic; fi
}
current_geq() {
  if [ -s "$GEQ_FILE" ]; then cat "$GEQ_FILE"; else echo off; fi
}
write_dropin() {
  P=$(current_profile)
  G=$(current_geq)
  mkdir -p "$DROPIN_DIR"
  cat > "$PROFILE_DROPIN.tmp" <<EOD
[Service]
Environment=SP11_DOLBY_PROFILE=$P
Environment=SP11_DOLBY_GEQ=$G
EOD
  mv "$PROFILE_DROPIN.tmp" "$PROFILE_DROPIN"
}
actual_profile() {
  PID=$(systemctl --user show filter-chain.service -p MainPID --value 2>/dev/null || true)
  if [ -n "$PID" ] && [ "$PID" != 0 ] && [ -r "/proc/$PID/environ" ]; then
    LIVE=$(tr '\0' '\n' < "/proc/$PID/environ" | sed -n 's/^SP11_DOLBY_PROFILE=//p' | tail -1)
    [ -n "$LIVE" ] && { printf '%s\n' "$LIVE"; return 0; }
  fi
  systemctl --user show filter-chain.service -p Environment --value 2>/dev/null \
    | tr ' ' '\n' | sed -n 's/^SP11_DOLBY_PROFILE=//p' | tail -1
}
runtime_control_state() {
  [ -r "$CONTROL_FILE" ] || return 1
  set -- $(od -An -tu1 -N2 "$CONTROL_FILE" 2>/dev/null)
  [ "$#" -ge 2 ] || return 1
  printf '%s %s\n' "$1" "$2"
}
runtime_profile() {
  STATE=$(runtime_control_state || true)
  set -- $STATE
  APPLIED=${2:-0}
  case "$APPLIED" in
    1|2|3|4|5|6|7) profile_name_from_code "$APPLIED" ;;
    *) actual_profile ;;
  esac
}
runtime_pending_profile() {
  STATE=$(runtime_control_state || true)
  set -- $STATE
  REQUEST=${1:-0}; APPLIED=${2:-0}
  case "$REQUEST" in
    1|2|3|4|5|6|7)
      [ "$REQUEST" = "$APPLIED" ] || profile_name_from_code "$REQUEST"
      ;;
  esac
}
runtime_postgain_state() {
  [ -r "$CONTROL_FILE" ] || return 1
  python3 - "$CONTROL_FILE" <<'PYPGSTATE'
import struct, sys
path=sys.argv[1]
try:
    data=open(path,'rb').read()
except OSError:
    raise SystemExit(1)
if len(data) < 12:
    raise SystemExit(1)
req=struct.unpack_from('<i',data,4)[0]
ack=struct.unpack_from('<i',data,8)[0]
print(req,ack)
PYPGSTATE
}
postgain_db() {
  awk -v p="$1" 'BEGIN{printf "%.3f", p/16.0}'
}
write_runtime_postgain() {
  V=$1
  python3 - "$CONTROL_FILE" "$V" <<'PYPG'
import os, struct, sys
path, value = sys.argv[1], int(sys.argv[2])
if not -1200 <= value <= 0:
    raise SystemExit(2)
size=12; none=-(1<<31)
fd=os.open(path, os.O_RDWR|os.O_CREAT|os.O_CLOEXEC, 0o600)
try:
    os.fchmod(fd,0o600)
    old=os.fstat(fd).st_size
    if old < size:
        os.ftruncate(fd,size)
        if old < 8:
            os.pwrite(fd,struct.pack('<i',none),4)
        if old < 12:
            os.pwrite(fd,struct.pack('<i',none),8)
    os.pwrite(fd,struct.pack('<i',value),4)
finally:
    os.close(fd)
PYPG
}
set_runtime_postgain() {
  V=$1
  case "$V" in ''|*[!0-9-]*) return 2 ;; esac
  [ "$V" -ge -1200 ] 2>/dev/null && [ "$V" -le 0 ] 2>/dev/null || return 2
  write_runtime_postgain "$V" || return 1
  N=0
  while [ "$N" -lt 10 ]; do
    STATE=$(runtime_postgain_state || true); set -- $STATE; APPLIED=${2:--2147483648}
    [ "$APPLIED" = "$V" ] && return 0
    N=$((N + 1)); sleep 0.02
  done
  return 3
}
write_runtime_profile_code() {
  C=$1
  python3 - "$CONTROL_FILE" "$C" <<'PYCTL'
import os, sys
path, code = sys.argv[1], int(sys.argv[2])
if not 1 <= code <= 7:
    raise SystemExit(2)
fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
try:
    os.fchmod(fd, 0o600)
    if os.fstat(fd).st_size < 2:
        os.ftruncate(fd, 2)
    os.pwrite(fd, bytes((code,)), 0)
finally:
    os.close(fd)
PYCTL
}
set_runtime_profile() {
  P=$1
  D=$(node_id 'effect_input.sp11_windows_dolby' || true)
  [ -n "$D" ] || return 1
  C=$(profile_code "$P") || return 1
  write_runtime_profile_code "$C" || return 1
  # If audio is already flowing the plugin acknowledges within a callback.
  # If idle, leave the request queued; it is applied before the first future
  # audio block and therefore still preserves the existing algorithm state.
  N=0
  while [ "$N" -lt 10 ]; do
    STATE=$(runtime_control_state || true); set -- $STATE; APPLIED=${2:-0}
    [ "$APPLIED" = "$C" ] && return 0
    N=$((N + 1)); sleep 0.02
  done
  return 3
}
status() {
  D=$(node_id 'effect_input.sp11_windows_dolby' || true)
  B=$(node_id 'effect_input.sp11_dolby_bypass' || true)
  DEF=$(wpctl status -n | awk '/Default Configured Devices:/{p=1;next} p && /Audio\/Sink/{print $0;exit}')
  WANT=$(current_profile)
  LIVE=$(runtime_profile || true)
  PENDING=$(runtime_pending_profile || true)
  if [ -n "$PENDING" ]; then
    echo "Profile: $WANT (live: ${LIVE:-unknown}; pending: $PENDING)"
  else
    echo "Profile: ${WANT}${LIVE:+ (live: $LIVE)}"
  fi
  G=$(current_geq)
  if [ "$G" = off ]; then echo "Custom GEQ: off"; else echo "Custom GEQ: saved (20 bands; active with personalize)"; fi
  PG=$(runtime_postgain_state || true); set -- $PG
  PGREQ=${1:--2147483648}; PGACK=${2:--2147483648}
  if [ "$PGACK" -ge -1200 ] 2>/dev/null && [ "$PGACK" -le 0 ] 2>/dev/null; then
    if [ "$PGREQ" != "$PGACK" ] && [ "$PGREQ" -ge -1200 ] 2>/dev/null && [ "$PGREQ" -le 0 ] 2>/dev/null; then
      echo "VLLDP endpoint postgain: $PGACK ($(postgain_db "$PGACK") dB; pending $PGREQ / $(postgain_db "$PGREQ") dB)"
    else
      echo "VLLDP endpoint postgain: $PGACK ($(postgain_db "$PGACK") dB)"
    fi
  elif [ "$PGREQ" -ge -1200 ] 2>/dev/null && [ "$PGREQ" -le 0 ] 2>/dev/null; then
    echo "VLLDP endpoint postgain: pending $PGREQ ($(postgain_db "$PGREQ") dB; applies before next audio block)"
  else
    echo "VLLDP endpoint postgain: unavailable"
  fi
  printf 'Volume sync: '; systemctl --user is-active sp11-dolby-volume-sync.service 2>/dev/null || true
  echo "Default: ${DEF:-unknown}"
  if [ -n "$D" ]; then printf 'Dolby:  '; wpctl get-volume "$D"; else echo 'Dolby:  unavailable'; fi
  if [ -n "$B" ]; then printf 'Bypass: '; wpctl get-volume "$B"; else echo 'Bypass: unavailable'; fi
  printf 'Dolby host: '; systemctl --user is-active filter-chain.service || true
}
select_dolby_default() {
  D=$(node_id 'effect_input.sp11_windows_dolby')
  wpctl set-default "$D"
}
snapshot_dolby_volume() {
  OLD_D=$(node_id 'effect_input.sp11_windows_dolby' || true)
  OLD_VOL=0.10
  OLD_MUTED=0
  if [ -n "$OLD_D" ]; then
    LINE=$(wpctl get-volume "$OLD_D" 2>/dev/null || true)
    V=$(printf '%s\n' "$LINE" | awk '{print $2}')
    case "$V" in
      ''|*[!0-9.]*) ;;
      *) OLD_VOL=$V ;;
    esac
    case "$LINE" in *MUTED*) OLD_MUTED=1 ;; esac
  fi
}
restore_dolby_volume() {
  D=$(node_id 'effect_input.sp11_windows_dolby')
  wpctl set-volume "$D" "$OLD_VOL"
  if [ "$OLD_MUTED" -eq 1 ]; then wpctl set-mute "$D" 1; fi
}
set_profile() {
  P=$(normalize_profile "$1") || {
    echo "Unknown profile '$1'." >&2
    echo 'Profiles: dynamic movie music game voice onlinecourse personalize' >&2
    exit 2
  }
  mkdir -p "$PROFILE_DIR" "$DROPIN_DIR"
  printf '%s\n' "$P" > "$PROFILE_FILE.tmp"
  mv "$PROFILE_FILE.tmp" "$PROFILE_FILE"
  write_dropin
  systemctl --user daemon-reload

  # Current production plugins expose an integer Profile LADSPA control.
  # PipeWire forwards this property to the existing plugin instance, whose
  # original Dolby setters retune VLLDP/VR without rebuilding either engine.
  # Keep the restart path only for older installed plugins / absent sinks.
  if set_runtime_profile "$P"; then
    select_dolby_default
    echo "SP11 Windows Dolby profile: $P (retuned in place)"
    status
    return 0
  else
    RC=$?
    if [ "$RC" -eq 3 ]; then
      select_dolby_default
      echo "SP11 Windows Dolby profile: $P (queued in place; applies on next audio block)"
      status
      return 0
    fi
  fi

  snapshot_dolby_volume
  systemctl --user reset-failed filter-chain.service 2>/dev/null || true
  systemctl --user restart filter-chain.service
  sleep 1
  restore_dolby_volume
  select_dolby_default
  echo "SP11 Windows Dolby profile: $P (compatibility restart)"
  status
}

set_geq() {
  MODE=${1:-show}
  case "$MODE" in
    show)
      current_geq
      return 0
      ;;
    off|flat|reset)
      G=off
      ;;
    set)
      shift
      [ "$#" -eq 20 ] || { echo 'GEQ needs exactly 20 integer bands.' >&2; exit 2; }
      G=
      for V in "$@"; do
        awk -v v="$V" 'BEGIN{exit !(v ~ /^-?[0-9]+$/ && v >= -192 && v <= 192)}' || {
          echo "Invalid GEQ value '$V'; allowed range is -192..192." >&2; exit 2;
        }
        if [ -z "$G" ]; then G=$V; else G="$G,$V"; fi
      done
      ;;
    *)
      echo 'Usage: sp11-dolby geq [show|off|reset|set <20 values -192..192>]' >&2
      exit 2
      ;;
  esac
  mkdir -p "$PROFILE_DIR"
  printf '%s\n' "$G" > "$GEQ_FILE.tmp"
  mv "$GEQ_FILE.tmp" "$GEQ_FILE"
  write_dropin
  snapshot_dolby_volume
  systemctl --user daemon-reload
  systemctl --user reset-failed filter-chain.service 2>/dev/null || true
  systemctl --user restart filter-chain.service
  sleep 1
  restore_dolby_volume
  select_dolby_default
  if [ "$G" = off ]; then echo 'SP11 Custom GEQ disabled.'; else echo 'SP11 Custom GEQ saved; it is active in the Personalize profile.'; fi
  status
}

case "${1:-status}" in
  status)
    status
    ;;
  profile)
    if [ "$#" -eq 1 ]; then current_profile; else set_profile "$2"; fi
    ;;
  geq)
    if [ "$#" -eq 1 ]; then set_geq show; else shift; set_geq "$@"; fi
    ;;
  postgain)
    if [ "$#" -eq 1 ]; then
      PG=$(runtime_postgain_state || true); set -- $PG
      echo "request=${1:--2147483648} applied=${2:--2147483648}"
    else
      set_runtime_postgain "$2" || {
        RC=$?
        if [ "$RC" -eq 3 ]; then echo "VLLDP postgain $2 queued; applies on next audio block."
        else echo 'postgain must be an integer from -1200 to 0.' >&2; exit "$RC"; fi
      }
    fi
    ;;
  sync-volume)
    SCRIPT="${SP11_DOLBY_VOLUME_SYNC:-$HOME/.local/bin/sp11-dolby-volume-sync}"
    [ -x "$SCRIPT" ] || { echo "Missing volume-sync helper: $SCRIPT" >&2; exit 2; }
    "$SCRIPT" --once --control "$CONTROL_FILE"
    ;;
  dynamic|movie|music|game|gaming|voice|onlinecourse|online-course|course|personalize|personalized|custom|custom1|custom2|custom3)
    set_profile "$1"
    ;;
  on|dolby)
    snapshot_dolby_volume
    systemctl --user reset-failed filter-chain.service 2>/dev/null || true
    systemctl --user start filter-chain.service
    sleep 1
    restore_dolby_volume
    select_dolby_default
    echo "SP11 Windows Dolby ($(current_profile)) is now the default output."
    status
    ;;
  off|bypass)
    B=$(node_id 'effect_input.sp11_dolby_bypass')
    wpctl set-default "$B"
    echo 'Transparent bypass is now the default output.'
    status
    ;;
  restart)
    snapshot_dolby_volume
    systemctl --user reset-failed filter-chain.service 2>/dev/null || true
    systemctl --user restart filter-chain.service
    sleep 1
    restore_dolby_volume
    select_dolby_default
    echo "Dolby host restarted ($(current_profile)) and restored as default."
    status
    ;;
  *)
    echo 'Usage: sp11-dolby [status|on|off|restart|profile [NAME]|postgain [VALUE]|sync-volume|geq [show|off|set ...]|dynamic|movie|music|game|voice|onlinecourse|personalize]' >&2
    exit 2
    ;;
esac
