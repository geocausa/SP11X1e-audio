[Unit]
Description=Capture SP11 protected-audio first-boot state
ConditionKernelCommandLine=sp11_entry=7.1.5-sp11-audio-v3
After=systemd-udev-settle.service sound.target
Wants=sound.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/sp11-audio-first-boot

[Install]
WantedBy=multi-user.target
