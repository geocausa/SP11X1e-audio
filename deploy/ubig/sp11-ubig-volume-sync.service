[Unit]
Description=SP11 Windows endpoint taper and UbiG volume feedback
After=pipewire.service wireplumber.service
Before=filter-chain.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=UBIG_CONTROL_PATH=%t/ubig-control-v2
Environment=UBIG_CONTROL_FORMAT=ubig-v2
ExecStart=%h/.local/bin/sp11-volume-sync-dispatch
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
