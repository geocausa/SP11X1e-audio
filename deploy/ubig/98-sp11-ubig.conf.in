# SP11 UbiG disposable native candidate.
#
# Keep the proven visible-sink / hidden-engine topology and exact node names
# used by the Golden Windows bridge.  Only the LADSPA implementation changes.
# @PLUGIN@ is expanded by prepare.sh to a per-user absolute path.
context.modules = [
  { name = libpipewire-module-filter-chain
    flags = [ nofail ]
    args = {
      node.description = "SP11 UbiG"
      media.name       = "SP11 UbiG"
      filter.graph = {
        nodes = [
          { type = builtin name = copy_l label = copy }
          { type = builtin name = copy_r label = copy }
        ]
        inputs  = [ "copy_l:In" "copy_r:In" ]
        outputs = [ "copy_l:Out" "copy_r:Out" ]
      }
      capture.props = {
        node.name        = "effect_input.sp11_ubig"
        node.description = "SP11 UbiG"
        media.class      = Audio/Sink
        audio.channels   = 2
        audio.position   = [ FL FR ]
        priority.session = 1700
      }
      playback.props = {
        node.name           = "effect_output.sp11_ubig_control_unused"
        node.description    = "SP11 UbiG Control (unused)"
        node.passive        = true
        node.autoconnect    = false
        node.dont-reconnect = true
        audio.channels      = 2
        audio.position      = [ FL FR ]
      }
    }
  }

  { name = libpipewire-module-filter-chain
    flags = [ nofail ]
    args = {
      node.description = "SP11 UbiG Engine"
      media.name       = "SP11 UbiG Engine"
      filter.graph = {
        nodes = [
          {
            type   = ladspa
            name   = ubig
            plugin = "@PLUGIN@"
            label  = ubig_sp11_candidate
            control = { "Bypass" = 0.0 "Profile" = 0.0 }
          }
        ]
        inputs  = [ "ubig:Input L" "ubig:Input R" ]
        outputs = [ "ubig:Output L" "ubig:Output R" ]
      }
      capture.props = {
        node.name           = "effect_input.sp11_ubig_engine"
        node.description    = "SP11 UbiG Engine"
        node.passive        = true
        node.autoconnect    = false
        node.dont-reconnect = true
        audio.channels      = 2
        audio.position      = [ FL FR ]
      }
      playback.props = {
        node.name        = "effect_output.sp11_ubig"
        node.description = "SP11 UbiG -> Speakers"
        node.target      = "alsa_output.platform-sound.HiFi__Speaker__sink"
        node.passive     = true
        audio.channels   = 2
        audio.position   = [ FL FR ]
      }
    }
  }
]
