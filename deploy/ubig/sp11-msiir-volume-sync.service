[Unit]
Description=SP11 Windows volume-dependent MSIIR calibration sync
After=pipewire.service wireplumber.service sp11-ubig-volume-sync.service
Wants=pipewire.service wireplumber.service sp11-ubig-volume-sync.service

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=%h/.local/bin/sp11-msiir-volume-sync
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
