#!/bin/sh
# Include the matched SP11 platform and audio modules in the isolated CPS V3
# initramfs. Every module comes from one complete unique-release build.

PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs) prereqs; exit 0 ;;
esac

. /usr/share/initramfs-tools/hook-functions

[ "${version:-}" = "7.1.5-sp11-cps-v3+" ] || exit 0

# Phase91 touchscreen transport trio. These matched modules must be embedded
# before the generic in-tree GPI and GENI SPI drivers can bind.
manual_add_modules gpi
manual_add_modules spi-geni-qcom
manual_add_modules mshw0485_touch

# SP11 WCN7850 Wi-Fi/Bluetooth and OLED display path.
manual_add_modules ath12k_wifi7
manual_add_modules ath12k
manual_add_modules hci_uart
manual_add_modules btqca
manual_add_modules msm

# Complete SoundWire/AudioReach protection path. regmap_sdw is explicit here
# because omitting it caused the rejected V2 mixed-ABI boot.
manual_add_modules regmap_sdw
manual_add_modules soundwire_bus
manual_add_modules soundwire_qcom
manual_add_modules snd_soc_wsa884x
manual_add_modules snd_soc_lpass_wsa_macro
manual_add_modules snd_q6dsp_common
manual_add_modules snd_q6apm
manual_add_modules q6apm_lpass_dais
manual_add_modules snd_soc_x1e80100

topology=/usr/lib/firmware/qcom/x1e80100/X1E80100-Microsoft-Surface-Pro-11-CPS-Parity-V2-tplg.bin
[ -f "$topology" ] || {
	echo "missing reviewed SP11 CPS topology: $topology" >&2
	exit 1
}
if [ ! -e "$DESTDIR$topology" ]; then
	copy_file firmware "$topology" "$topology"
fi

# A pre-existing destination means another hook already included the reviewed
# topology; that is success, not a reason to abort initramfs generation.
exit 0
