# Generated live-state captures and decoded/compiled topology files.
artifacts/live/
build/
*.pyc
__pycache__/

# Recovered vendor captures/calibration stay local. Reviewed structural facts,
# generators and hashes are versioned; opaque payload bytes are not published.
artifacts/raw/
artifacts/topology-recovery/
artifacts/reviewed/windows-acdb-rev0d-root-protection-setcfg.json
# Reproducible one-shot boot bundle. It contains a >100 MB initrd and rebuilt
# kernel modules; reviewed topology inventories and hashes are tracked instead.
artifacts/audio-cps-lab-candidate-20260810/
deploy/firmware/*.bin
deploy/firmware/reference/

# Vendor runtime binaries and state-pinned Windows evidence are supplied locally.
# The repository carries hashes, parsers and generators instead of redistributing
# third-party DLLs, process dumps or captured audio.
*.dll
*.dmp
*.wav
*.bundle
/dolby-port/dll/
/dolby-port/*.bin

# Operator handoffs can contain transient debugger transport credentials.
docs/handoff/
docs/handoffs/

