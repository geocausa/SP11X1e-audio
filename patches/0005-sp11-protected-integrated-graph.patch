@@ -1780,6 +1780,16 @@ static int wsa884x_hw_params(struct snd_pcm_substream *substream,
 		if (!wsa884x->port_enable[i])
 			continue;
 
+		/*
+		 * These protection ports are not playback RX audio.  Adding
+		 * them to this RX stream gives them the wrong SoundWire
+		 * direction and causes a bus clash.  Their enable state is
+		 * retained for the codec and integrated ADSP protection path.
+		 */
+		if (i == WSA884X_PORT_VISENSE || i == WSA884X_PORT_CPS ||
+		    i == WSA884X_PORT_PBR)
+			continue;
+
 		wsa884x->port_config[wsa884x->active_ports] = wsa884x_pconfig[i];
 		wsa884x->active_ports++;
 	}
