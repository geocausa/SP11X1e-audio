From: SP11 audio reconstruction project
Subject: [PATCH] ASoC: qcom: audioreach: send protected calibration per frame

The SP11 DSP rejects a SET_CFG containing the complete multi-parameter
graph calibration with status 1. Earlier instrumented Linux tests on the
same firmware proved that parameters rejected when packed together are
accepted when sent as separate SET_CFG transactions.

Preserve the recovered parameter bytes and order, but send every static
calibration frame in its own OOB transaction. Report the exact frame index,
module instance and parameter ID if the DSP rejects an individual payload.

---
 sound/soc/qcom/qdsp6/audioreach.c | 48 +++++++++++++++++++++++++++++----------
 1 file changed, 37 insertions(+), 11 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -1054,6 +1054,38 @@ static const u8 *audioreach_stage_frame(
 	return NULL;
 }
 
+static int audioreach_send_oob_stage(struct audioreach_graph *graph,
+				     const struct audioreach_module_priv_data *stage)
+{
+	size_t size = le32_to_cpu(stage->size);
+	const u8 *cursor = (const u8 *)stage->data;
+	const u8 *end = cursor + size;
+	unsigned int index = 0;
+
+	while (cursor < end) {
+		u32 iid = get_unaligned_le32(cursor);
+		u32 param_id = get_unaligned_le32(cursor + sizeof(u32));
+		u32 param_size = get_unaligned_le32(cursor + 2 * sizeof(u32));
+		size_t frame_size =
+			ALIGN(sizeof(struct apm_module_param_data) + param_size, 8);
+		int ret;
+
+		if (frame_size > end - cursor)
+			return -EINVAL;
+		ret = q6apm_send_oob_config(graph, cursor, frame_size);
+		if (ret) {
+			dev_err(graph->apm->dev,
+				"OOB stage frame %u iid 0x%08x param 0x%08x failed: %d\n",
+				index, iid, param_id, ret);
+			return ret;
+		}
+		cursor += frame_size;
+		index++;
+	}
+
+	return cursor == end ? 0 : -EINVAL;
+}
+
 static int audioreach_validate_protection_profile(
 	const struct audioreach_graph_info *info,
 	const struct audioreach_module_priv_data *graph_cal,
@@ -1147,12 +1179,10 @@ int audioreach_send_protected_graph_calibration(struct audioreach_graph *graph)
 	if (ret)
 		return ret;
 
-	ret = q6apm_send_oob_config(graph, graph_cal->data,
-				    le32_to_cpu(graph_cal->size));
+	ret = audioreach_send_oob_stage(graph, graph_cal);
 	if (ret)
 		return ret;
-	return q6apm_send_oob_config(graph, render_ep->data,
-				      le32_to_cpu(render_ep->size));
+	return audioreach_send_oob_stage(graph, render_ep);
 }
 EXPORT_SYMBOL_GPL(audioreach_send_protected_graph_calibration);
 
@@ -1204,8 +1234,7 @@ int audioreach_configure_protection(struct q6apm_graph *graph)
 	ret = audioreach_send_inband_frame(graph, frame);
 	if (ret)
 		goto out;
-	ret = q6apm_send_oob_config(ar_graph, sp_tag->data,
-				    le32_to_cpu(sp_tag->size));
+	ret = audioreach_send_oob_stage(ar_graph, sp_tag);
 	if (ret)
 		goto out;
 	for (int i = 1; i < 4; i++) {
@@ -1214,12 +1243,10 @@ int audioreach_configure_protection(struct q6apm_graph *graph)
 		if (ret)
 			goto out;
 	}
-	ret = q6apm_send_oob_config(ar_graph, spvi_tag->data,
-				    le32_to_cpu(spvi_tag->size));
+	ret = audioreach_send_oob_stage(ar_graph, spvi_tag);
 	if (ret)
 		goto out;
-	ret = q6apm_send_oob_config(ar_graph, vi_ep->data,
-				    le32_to_cpu(vi_ep->size));
+	ret = audioreach_send_oob_stage(ar_graph, vi_ep);
 	if (ret)
 		goto out;
 
-- 
