From 11d875d6bcde48e16fa5fb8f6d52940d4069309c Mon Sep 17 00:00:00 2001
From: SP11 audio reconstruction <sp11-audio@localhost>
Date: Tue, 11 Aug 2026 23:19:15 +0100
Subject: [PATCH] arm64: dts: qcom: disable broken SP11 WiFi rfkill

---
 arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi b/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi
index 6a3a7c7..c1884c0 100644
--- a/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi
+++ b/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi
@@ -994,6 +994,8 @@ &pcie4_port0 {
 	wifi@0 {
 		compatible = "pci17cb,1107";
 		reg = <0x10000 0x0 0x0 0x0 0x0>;
+		/* Surface firmware reports the WCN7850 RF-kill GPIO inverted. */
+		disable-rfkill;
 
 		vddaon-supply = <&vreg_pmu_aon_0p59>;
 		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
-- 
2.53.0
