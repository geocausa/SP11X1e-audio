+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_apm_cmd_pkt(payload_size,
+					    APM_CMD_SHARED_MEM_MAP_REGIONS,
+					    token);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
