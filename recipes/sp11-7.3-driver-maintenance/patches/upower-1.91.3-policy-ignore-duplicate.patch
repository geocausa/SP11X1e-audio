+    def test_policy_ignored_duplicate_battery(self):
+        """Ignore only the policy-selected duplicate, including change events."""
+        attrs = ["type", "Battery", "present", "1", "status", "Discharging",
+                 "energy_full", "51250000", "energy_full_design", "51480000",
+                 "energy_now", "40000000", "voltage_now", "8600000"]
+        self.testbed.add_device("power_supply", "BAT1", None, attrs, [])
+        duplicate = self.testbed.add_device("power_supply", "qcom-battmgr-bat",
+                                           None, attrs, ["UPOWER_IGNORE", "1"])
+        self.start_daemon()
+        self.assertEqual(len(self.proxy.EnumerateDevices()), 1)
+        self.assertAlmostEqual(self.get_dbus_display_property("EnergyFull"), 51.25)
+        # Unknown/unselected interfaces continue to work as normal batteries.
+        self.testbed.set_property(duplicate, "UPOWER_IGNORE", "0")
+        self.testbed.uevent(duplicate, "change")
+        deadline = time.monotonic() + 5
+        while len(self.proxy.EnumerateDevices()) != 2 and time.monotonic() < deadline:
+            time.sleep(0.05)
+        self.assertEqual(len(self.proxy.EnumerateDevices()), 2)
+        self.assertAlmostEqual(self.get_dbus_display_property("EnergyFull"), 102.5)
+        self.testbed.set_property(duplicate, "UPOWER_IGNORE", "1")
+        self.testbed.uevent(duplicate, "change")
+        deadline = time.monotonic() + 5
+        while len(self.proxy.EnumerateDevices()) != 1 and time.monotonic() < deadline:
+            time.sleep(0.05)
+        self.assertEqual(len(self.proxy.EnumerateDevices()), 1)
+        self.assertAlmostEqual(self.get_dbus_display_property("EnergyFull"), 51.25)
+
