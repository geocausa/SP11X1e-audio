bu qcadcm8380+0x5aa34 "r @$t2=poi(@sp+0xd0); r @$t3=dwo(@sp+0x24); r @$t4=dwo(@sp+0x20); r @$t5=dwo(@sp+0x28); .if ((@$t3 >= 0x500) & (@$t3 <= 0x4000) & ((@$t4+@$t5) == @$t3) & (@$t2 > 0xffff000000000000)) { r @$t1=@$t1+1; .echo ===== CODEX_QCADCM_OOB_BEGIN =====; ? @$t1; ? @$t2; ? @$t3; ? @$t4; ? @$t5; db @$t2 L?@$t3; .echo ===== CODEX_QCADCM_OOB_END =====; .if (@$t1 >= 32) { .echo CODEX_QCADCM_OOB_HIT_LIMIT_REACHED; bd @$bpnum; gc } .else { gc } } .else { gc }"
